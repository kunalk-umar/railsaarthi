# ─── RailSaarthi Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your API keys
# DO NOT commit .env to git

PORT=8080

# ── IndianRailAPI (Free: 1000 req/day) ─────────────────────────────
# Register at: https://indianrailapi.com
INDIANRAIL_API_KEY=your_key_here

# ── RapidAPI — Indian Railway (Free tier: 500 req/month) ───────────
# Subscribe at: https://rapidapi.com/search/indian-railway
RAPIDAPI_KEY=your_key_here

# ── Optional: Which API to prefer (indianrail | rapidapi | auto) ───
API_PROVIDER=auto
